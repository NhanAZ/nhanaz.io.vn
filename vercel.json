{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build-vercel.mjs",
  "outputDirectory": "_site",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/pricing",
      "destination": "/pricing.md"
    },
    {
      "source": "/pricing/",
      "destination": "/pricing.md"
    },
    {
      "source": "/sandbox",
      "destination": "/sandbox.json"
    },
    {
      "source": "/sandbox/",
      "destination": "/sandbox.json"
    },
    {
      "source": "/ask",
      "destination": "/api/ask"
    },
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/mcp/",
      "destination": "/api/mcp"
    },
    {
      "source": "/mcp/docs",
      "destination": "/api/mcp-docs"
    },
    {
      "source": "/mcp/product",
      "destination": "/api/mcp-product"
    },
    {
      "source": "/mcp/product/",
      "destination": "/api/mcp-product"
    },
    {
      "source": "/mcp/server-card",
      "destination": "/.well-known/mcp/server-card.json"
    },
    {
      "source": "/mcp/server-card.json",
      "destination": "/.well-known/mcp/server-card.json"
    },
    {
      "source": "/mcp/.well-known/server-card.json",
      "destination": "/.well-known/mcp/server-card.json"
    },
    {
      "source": "/mcp/product/server-card",
      "destination": "/.well-known/mcp/product/server-card.json"
    },
    {
      "source": "/mcp/product/server-card.json",
      "destination": "/.well-known/mcp/product/server-card.json"
    },
    {
      "source": "/mcp/product/.well-known/server-card.json",
      "destination": "/.well-known/mcp/product/server-card.json"
    },
    {
      "source": "/mcp-product",
      "destination": "/api/mcp-product"
    },
    {
      "source": "/mcp-product/",
      "destination": "/api/mcp-product"
    },
    {
      "source": "/.well-known/mcp/product",
      "destination": "/api/mcp-product"
    },
    {
      "source": "/.well-known/mcp-product",
      "destination": "/api/mcp-product"
    },
    {
      "source": "/a2a",
      "destination": "/api/a2a"
    },
    {
      "source": "/a2a/",
      "destination": "/api/a2a"
    },
    {
      "source": "/a2ui",
      "destination": "/api/a2ui"
    },
    {
      "source": "/a2ui/",
      "destination": "/api/a2ui"
    },
    {
      "source": "/v1",
      "destination": "/api/v1/index"
    },
    {
      "source": "/v1/",
      "destination": "/api/v1/index"
    },
    {
      "source": "/v2",
      "destination": "/api/index"
    },
    {
      "source": "/v2/",
      "destination": "/api/index"
    },
    {
      "source": "/.well-known/mcp",
      "destination": "/api/mcp-manifest"
    },
    {
      "source": "/.well-known/mcp/",
      "destination": "/api/mcp-manifest"
    }
  ],
  "headers": [
    {
      "source": "/assets/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "</sitemap.xml>; rel=\"sitemap\", </index.md>; rel=\"alternate\"; type=\"text/markdown\", </openapi.json>; rel=\"service-desc\"; type=\"application/vnd.oai.openapi+json\""
        },
        {
          "key": "Vary",
          "value": "Accept, User-Agent"
        }
      ]
    },
    {
      "source": "/developers",
      "headers": [
        {
          "key": "Link",
          "value": "</developers.md>; rel=\"alternate\"; type=\"text/markdown\", </llms.txt>; rel=\"alternate\"; type=\"text/plain\", </openapi.json>; rel=\"service-desc\"; type=\"application/vnd.oai.openapi+json\""
        },
        {
          "key": "Vary",
          "value": "Accept, User-Agent"
        }
      ]
    },
    {
      "source": "/developers/",
      "headers": [
        {
          "key": "Link",
          "value": "</developers.md>; rel=\"alternate\"; type=\"text/markdown\", </llms.txt>; rel=\"alternate\"; type=\"text/plain\", </openapi.json>; rel=\"service-desc\"; type=\"application/vnd.oai.openapi+json\""
        },
        {
          "key": "Vary",
          "value": "Accept, User-Agent"
        }
      ]
    },
    {
      "source": "/.well-known/api-catalog",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/linkset+json; profile=\"https://www.rfc-editor.org/info/rfc9727\""
        }
      ]
    },
    {
      "source": "/.well-known/mcp",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/.well-known/mcp/server-card.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/mcp-server-card+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/.well-known/mcp/product/server-card.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/mcp-server-card+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/.well-known/mcp-product/server-card.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/mcp-server-card+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/mcp/server-card",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/mcp-server-card+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/mcp/server-card.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/mcp-server-card+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/mcp/.well-known/server-card.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/mcp-server-card+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/mcp/product/server-card",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/mcp-server-card+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/mcp/product/server-card.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/mcp-server-card+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/mcp/product/.well-known/server-card.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/mcp-server-card+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/.well-known/agent-card.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/a2a+json; charset=utf-8"
        }
      ]
    }
    ,
    {
      "source": "/.well-known/oauth-protected-resource",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        }
      ]
    }
  ]
}
